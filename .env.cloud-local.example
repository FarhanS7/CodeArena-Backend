# ==============================================================
# CODE ARENA - LOCAL CLOUD DEVELOPMENT ENVIRONMENT
# ==============================================================
# This file is for running the services locally on your machine 
# WITHOUT Docker, while connecting to CLOUD databases (e.g. Neon).
# Copy this to `.env` and fill in your cloud URLs.
# ==============================================================

# --- GLOBAL ---
JWT_SECRET=your_jwt_secret_at_least_32_chars
MEILI_MASTER_KEY=masterKey123
FRONTEND_URL=http://localhost:3000

# --- CLOUD REDIS (Render/Upstash) ---
# Format: redis://red-xxxxx:port
REDIS_HOST=your-cloud-redis-url.com
REDIS_PORT=6379
# If your cloud redis requires a password, you might need to add REDIS_PASSWORD to your services

# --- MEILISEARCH ---
# URL of your deployed Meilisearch
MEILI_URL=https://your-meilisearch-url.com

# --- AI SERVICE ---
GEMINI_API_KEY=your_gemini_api_key

# --- EMAIL SERVICE ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password

# --- EXECUTION SERVICE ---
JUDGE0_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=your_judge0_api_key

# ==============================================================
# CLOUD DATABASES (NEON DB)
# Replace these with your actual NeonDB connection details
# ==============================================================

# --- AUTH SERVICE DB ---
AUTH_DB_USER=your_neon_user
AUTH_DB_PASSWORD=your_neon_password
AUTH_DB_NAME=auth_db
AUTH_DB_HOST=ep-example-123456.us-east-2.aws.neon.tech
AUTH_DB_PORT=5432

# --- EXECUTION SERVICE DB ---
EXECUTION_DB_USER=your_neon_user
EXECUTION_DB_PASSWORD=your_neon_password
EXECUTION_DB_NAME=execution_db
EXECUTION_DB_HOST=ep-example-123456.us-east-2.aws.neon.tech
EXECUTION_DB_PORT=5432

# --- PROBLEM SERVICE DB (Spring Boot) ---
# Note: Spring Boot uses SPRING_DATASOURCE_URL. We provide it here:
SPRING_DATASOURCE_URL=jdbc:postgresql://ep-example-123456.us-east-2.aws.neon.tech:5432/problem_db?sslmode=require
SPRING_DATASOURCE_USERNAME=your_neon_user
SPRING_DATASOURCE_PASSWORD=your_neon_password
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_PROFILES_ACTIVE=local

# --- LEADERBOARD SERVICE DB ---
LEADERBOARD_DB_USER=your_neon_user
LEADERBOARD_DB_PASSWORD=your_neon_password
LEADERBOARD_DB_NAME=leaderboard_db
LEADERBOARD_DB_HOST=ep-example-123456.us-east-2.aws.neon.tech
LEADERBOARD_DB_PORT=5432

# --- DISCUSSION SERVICE DB ---
DISCUSSION_DB_USER=your_neon_user
DISCUSSION_DB_PASSWORD=your_neon_password
DISCUSSION_DB_NAME=discussion_db
DISCUSSION_DB_HOST=ep-example-123456.us-east-2.aws.neon.tech
DISCUSSION_DB_PORT=5432

# --- CONTEST SERVICE DB ---
CONTEST_DB_USER=your_neon_user
CONTEST_DB_PASSWORD=your_neon_password
CONTEST_DB_NAME=contest_db
CONTEST_DB_HOST=ep-example-123456.us-east-2.aws.neon.tech
CONTEST_DB_PORT=5432

# ==============================================================
# INTERNAL SERVICE URLS (For local routing)
# Do not change these unless you change the ports in the code
# ==============================================================
AUTH_SERVICE_URL=http://localhost:3001
EXECUTION_SERVICE_URL=http://localhost:3002
LEADERBOARD_SERVICE_URL=http://localhost:3003
DISCUSSION_SERVICE_URL=http://localhost:3004
SOCIAL_SERVICE_URL=http://localhost:3005
AI_SERVICE_URL=http://localhost:3006
SEARCH_SERVICE_URL=http://localhost:3007
CONTEST_SERVICE_URL=http://localhost:3008
PROBLEM_SERVICE_URL=http://localhost:8080
EMAIL_SERVICE_URL=http://localhost:3010
